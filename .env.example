# ==============================================================================
# JAVIER ESPINOSA PHOTOGRAPHY — VARIABLES DE ENTORNO (.env.local / Vercel)
# ==============================================================================
# Copia este archivo a .env.local para desarrollo o configura las variables en:
# Vercel Dashboard → Project Settings → Environment Variables
# Ejecuta `npm run check:env` para verificar tu configuración local.

# 1. URL canónica del sitio en producción (sin barra final)
NEXT_PUBLIC_SITE_URL="https://javier-photography.vercel.app"

# 2. Botón flotante de WhatsApp (solo dígitos con prefijo de país, ej. 34600000000)
# Si se deja vacío, el botón de WhatsApp NO se muestra.
NEXT_PUBLIC_WHATSAPP=""

# 3. Correo transaccional con Resend (https://resend.com)
# Usado por /api/contact, /api/order y como respaldo de /api/subscribe.
# Si no se configura, se utiliza el relé FormSubmit hacia javierespinosa1995@hotmail.com.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Javier Espinosa Fotografía <galeria@tudominio.es>"

# 4. Pasarela de pago Stripe (https://dashboard.stripe.com/apikeys)
# Usa sk_test_... para pruebas o sk_live_... en producción.
# Si se deja vacío, la tienda funciona en modo "Solicitud de Reserva" sin cobro con tarjeta.
STRIPE_SECRET_KEY=""
# Webhook secret de Stripe (https://dashboard.stripe.com/webhooks) para /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Activa los botones públicos de "Comprar con tarjeta" (debe ser "true" solo cuando STRIPE_SECRET_KEY esté configurada)
NEXT_PUBLIC_STRIPE_ACTIVE=""
# Opcional: fija manualmente el tipo de cambio orientativo EUR -> USD mostrado en /en (por defecto usa referencia diaria del BCE)
NEXT_PUBLIC_EUR_USD_RATE=""

# 5. Lista de avisos de nuevas tiradas Fine Art (/api/subscribe)
# Opción A: Resend Audiences (recomendado si ya usas Resend)
NEWSLETTER_PROVIDER="resend"
NEWSLETTER_AUDIENCE_ID=""
# Opción B: Webhook externo (Make, Zapier, n8n, Mailchimp webhook...)
NEWSLETTER_WEBHOOK_URL=""

# 6. Panel Privado de Autor (/admin)
ADMIN_USER="Javier"
ADMIN_PIN="88722"
AUTH_SECRET="cambia-esta-clave-secreta-para-firmar-sesiones-admin"

# 7. Notificaciones push instantáneas al móvil del autor (ntfy y/o Telegram)
# Opción A (más rápida en iPhone/Android): app gratuita "ntfy" con un nombre de tema privado y largo
ADMIN_NTFY_TOPIC=""
# Opcional: si usas servidor ntfy propio o cuenta ntfy Pro
ADMIN_NTFY_SERVER="https://ntfy.sh"
ADMIN_NTFY_TOKEN=""
# Opción B (alternativa o respaldo): Bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 8. Sincronización directa con GitHub (opcional para auto-commit desde /admin en Vercel)
GITHUB_TOKEN=""
GITHUB_REPO_OWNER="creatorcurro19"
GITHUB_REPO_NAME="javier-photography"
